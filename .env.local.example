# JCVIZ Landing — Sanity environment variables.
# Copy this file to `.env.local` and fill the values from your Sanity project.
#
# How to get these values:
# 1. Go to https://www.sanity.io/manage and select your project.
# 2. Project ID: shown at the top of the project dashboard.
# 3. Dataset: usually "production" (default) — visible under "Datasets".
# 4. API tokens: Settings → API → Tokens → "Add API token".
#    - Read token (Viewer role)  — for previews / drafts.
#    - Write token (Editor role) — for `npm run seed:sanity`.
#
# Once filled, run `npm run dev` and the embedded Studio at /studio will load.
# Never commit `.env.local` — it's in .gitignore.

# --- Public (exposed to browser) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01

# --- Server-side only ---
# Read token (Viewer role) — required for the Presentation tool's live draft
# preview (/studio → Presentation). Lets the server read unpublished drafts.
# Leave empty to disable draft preview; the published site works unchanged.
# For production preview, also add this var in Vercel (Production env).
SANITY_API_READ_TOKEN=

# Write token (Editor role) — required only for seeding content via
# `npm run seed:sanity`. Once content is in Sanity, this can stay empty
# in production (frontend only needs the read CDN client).
SANITY_API_WRITE_TOKEN=

# Webhook secret for on-demand revalidation. Set this when wiring up the
# Sanity → Vercel webhook (later step).
SANITY_REVALIDATE_SECRET=
